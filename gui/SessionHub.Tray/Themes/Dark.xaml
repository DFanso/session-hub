<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark tokens of the kv tray design system (kv, crates/kv/src/tray/page/app.css, MIT/Apache-2.0). -->
    <Color x:Key="BgColor">#24211F</Color>
    <SolidColorBrush x:Key="Bg" Color="#24211F" />
    <Color x:Key="BgTopColor">#393431</Color>
    <SolidColorBrush x:Key="BgTop" Color="#393431" />
    <Color x:Key="GlowColor">#1AFF6A3D</Color>
    <SolidColorBrush x:Key="Glow" Color="#1AFF6A3D" />
    <Color x:Key="SurfaceColor">#2E2A28</Color>
    <SolidColorBrush x:Key="Surface" Color="#2E2A28" />
    <Color x:Key="Surface2Color">#383431</Color>
    <SolidColorBrush x:Key="Surface2" Color="#383431" />
    <Color x:Key="GlassColor">#0FFFFFFF</Color>
    <SolidColorBrush x:Key="Glass" Color="#0FFFFFFF" />
    <Color x:Key="GlassHoverColor">#1AFFFFFF</Color>
    <SolidColorBrush x:Key="GlassHover" Color="#1AFFFFFF" />
    <Color x:Key="LineColor">#423D3A</Color>
    <SolidColorBrush x:Key="Line" Color="#423D3A" />
    <Color x:Key="LineStrongColor">#544E4A</Color>
    <SolidColorBrush x:Key="LineStrong" Color="#544E4A" />
    <Color x:Key="TextColor">#F7F5F3</Color>
    <SolidColorBrush x:Key="Text" Color="#F7F5F3" />
    <Color x:Key="Text2Color">#C9C3BE</Color>
    <SolidColorBrush x:Key="Text2" Color="#C9C3BE" />
    <Color x:Key="MutedColor">#B8B1AC</Color>
    <SolidColorBrush x:Key="Muted" Color="#B8B1AC" />
    <Color x:Key="AccentColor">#FF9A78</Color>
    <SolidColorBrush x:Key="Accent" Color="#FF9A78" />
    <Color x:Key="AccentSoftColor">#2EFF6A3D</Color>
    <SolidColorBrush x:Key="AccentSoft" Color="#2EFF6A3D" />
    <Color x:Key="AccentFillColor">#C93C14</Color>
    <SolidColorBrush x:Key="AccentFill" Color="#C93C14" />
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <Color x:Key="TealColor">#7CCBF7</Color>
    <SolidColorBrush x:Key="Teal" Color="#7CCBF7" />
    <Color x:Key="TealSoftColor">#264FB8F2</Color>
    <SolidColorBrush x:Key="TealSoft" Color="#264FB8F2" />
    <Color x:Key="AmberColor">#FFBE4D</Color>
    <SolidColorBrush x:Key="Amber" Color="#FFBE4D" />
    <Color x:Key="AmberSoftColor">#26FFB020</Color>
    <SolidColorBrush x:Key="AmberSoft" Color="#26FFB020" />
    <Color x:Key="AmberEdgeColor">#66FFB020</Color>
    <SolidColorBrush x:Key="AmberEdge" Color="#66FFB020" />
    <Color x:Key="RedColor">#FFB0B0</Color>
    <SolidColorBrush x:Key="Red" Color="#FFB0B0" />
    <Color x:Key="RedSoftColor">#26FF5C5C</Color>
    <SolidColorBrush x:Key="RedSoft" Color="#26FF5C5C" />
    <Color x:Key="RedEdgeColor">#73FF5C5C</Color>
    <SolidColorBrush x:Key="RedEdge" Color="#73FF5C5C" />
    <Color x:Key="RedFillColor">#C42B2B</Color>
    <SolidColorBrush x:Key="RedFill" Color="#C42B2B" />
    <Color x:Key="RedDotColor">#FF5C5C</Color>
    <SolidColorBrush x:Key="RedDot" Color="#FF5C5C" />
    <Color x:Key="GreenColor">#5BE3A0</Color>
    <SolidColorBrush x:Key="Green" Color="#5BE3A0" />
    <Color x:Key="GreenSoftColor">#263DD68C</Color>
    <SolidColorBrush x:Key="GreenSoft" Color="#263DD68C" />
    <Color x:Key="VioletColor">#B9A6FF</Color>
    <SolidColorBrush x:Key="Violet" Color="#B9A6FF" />
    <Color x:Key="VioletSoftColor">#29A088FF</Color>
    <SolidColorBrush x:Key="VioletSoft" Color="#29A088FF" />
    <Color x:Key="BadgeColor">#FFBE4D</Color>
    <SolidColorBrush x:Key="Badge" Color="#FFBE4D" />
    <Color x:Key="BadgeFgColor">#1E1A17</Color>
    <SolidColorBrush x:Key="BadgeFg" Color="#1E1A17" />
    <Color x:Key="ShadowColor">#8C000000</Color>
    <SolidColorBrush x:Key="Shadow" Color="#8C000000" />
    <!-- 170 deg linear gradient bg-top to bg (70 %), with a radial glow at the top right. -->
    <LinearGradientBrush x:Key="PanelBackground" StartPoint="0.41,0" EndPoint="0.59,1">
        <GradientStop Offset="0" Color="{StaticResource BgTopColor}" />
        <GradientStop Offset="0.7" Color="{StaticResource BgColor}" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="PanelGlow" Center="0.85,-0.1" GradientOrigin="0.85,-0.1" RadiusX="2.2" RadiusY="0.55">
        <GradientStop Offset="0" Color="{StaticResource GlowColor}" />
        <GradientStop Offset="0.6" Color="Transparent" />
    </RadialGradientBrush>
</ResourceDictionary>
