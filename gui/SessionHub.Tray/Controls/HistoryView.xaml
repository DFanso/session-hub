<UserControl x:Class="SessionHub.Tray.Controls.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SessionHub.Tray.Controls">
    <!-- DataContext: HistoryViewModel. Messages oldest first in a virtualized list; the search replaces them with hits. -->
    <UserControl.Resources>
        <DataTemplate x:Key="HistoryBubble">
            <Border x:Name="bubble" CornerRadius="12" Padding="10,8" Margin="0,4" HorizontalAlignment="Left"
                    Background="{DynamicResource Surface2}"
                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsPresenter}, Converter={StaticResource Fraction}, ConverterParameter=0.92}">
                <StackPanel>
                    <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <TextBlock Text="(message shortened)" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"
                               Visibility="{Binding Shortened, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding FromOwner}" Value="True">
                    <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="bubble" Property="Background" Value="{DynamicResource AccentSoft}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="HitTemplate">
            <Border CornerRadius="12" Padding="10,8" Margin="0,4" Background="{DynamicResource Surface2}">
                <StackPanel>
                    <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,2"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search over every session's last 7 days. -->
        <Border Margin="16,12,16,0" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                Background="{DynamicResource Glass}" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:Glyph Data="{StaticResource Icon.Search}" Size="16" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search messages of every session"
                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis" />
                <TextBox x:Name="Search" Grid.Column="1" Style="{StaticResource BareTextBox}" Padding="0,9"
                         AutomationProperties.Name="Search history" MaxLength="200"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnSearchChanged"
                         PreviewKeyDown="OnSearchKey" />
            </Grid>
        </Border>

        <!-- "Last 7 days · secrets masked", then Load older or Start of history. -->
        <Grid Grid.Row="1" Margin="16,8,16,4" MinHeight="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Text="{Binding InfoLine}" />
            <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Margin="10,0,0,0" Click="OnLoadOlder"
                    Visibility="{Binding ShowLoadOlder, Converter={StaticResource Visible}}" AutomationProperties.Name="Load older">
                <TextBlock Text="Load older" />
            </Button>
            <TextBlock Grid.Column="1" Style="{StaticResource Note}" Margin="10,0,0,0" VerticalAlignment="Center" Text="Start of history"
                       Visibility="{Binding ShowStart, Converter={StaticResource Visible}}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Note}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding CapNote}"
                       TextWrapping="NoWrap" Visibility="{Binding ShowCapNote, Converter={StaticResource Visible}}" />
        </Grid>

        <!-- Why nothing (more) shows: its own strip, never over the messages. -->
        <Border Grid.Row="2" Margin="16,0,16,8" CornerRadius="10" Padding="10,7" BorderThickness="1"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                Visibility="{Binding ShowNotice, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Note}" Text="{Binding Notice}" />
        </Border>

        <ItemsControl x:Name="Messages" Grid.Row="3" ItemsSource="{Binding Lines}" Padding="16,0,10,12" AutomationProperties.Name="Messages"
                      ItemTemplate="{StaticResource HistoryBubble}" Template="{StaticResource ScrollingList}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                      Visibility="{Binding IsSearching, Converter={StaticResource Hidden}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ItemsControl x:Name="HitList" Grid.Row="3" ItemsSource="{Binding Hits}" Padding="16,0,10,12" AutomationProperties.Name="Search results"
                      ItemTemplate="{StaticResource HitTemplate}" Template="{StaticResource ScrollingList}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                      Visibility="{Binding IsSearching, Converter={StaticResource Visible}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

    </Grid>
</UserControl>
