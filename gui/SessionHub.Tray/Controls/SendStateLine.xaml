<UserControl x:Class="SessionHub.Tray.Controls.SendStateLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:SessionHub.Tray">
    <!-- DataContext: CardViewModel. Spinner while a send is pending or held, the state text, and "Send anyway" for send-in-flight or, as its own link, after the secret warning (looks-secret). -->
    <StackPanel Orientation="Horizontal" MinHeight="18">
        <Border x:Name="Spinner" Width="10" Height="10" Margin="0,0,6,0" CornerRadius="5" BorderThickness="2"
                VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                Visibility="{Binding SendBusy, Converter={StaticResource Visible}}">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="{DynamicResource AmberColor}" />
                    <GradientStop Offset="0.7" Color="{DynamicResource AmberColor}" />
                    <GradientStop Offset="0.7" Color="Transparent" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.RenderTransform>
                <RotateTransform x:Name="SpinAngle" />
            </Border.RenderTransform>
        </Border>
        <TextBlock Style="{StaticResource SendState}" Text="{Binding SendBox.StateText}" MaxWidth="{Binding TextMaxWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <Button Style="{StaticResource LinkButton}" Margin="8,0,0,0" FontSize="12"
                Visibility="{Binding SendBox.CanOverride, Converter={StaticResource Visible}}"
                Command="t:PanelCommands.SendAnyway" CommandParameter="{Binding}" Content="Send anyway" />
        <!-- After the secret warning: a deliberate click (or Tab + Space); Enter in the box only sends normally. -->
        <Button Style="{StaticResource LinkButton}" Margin="8,0,0,0" FontSize="12"
                Visibility="{Binding SendBox.CanSendAnyway, Converter={StaticResource Visible}}"
                Command="t:PanelCommands.SendSecretAnyway" CommandParameter="{Binding}" Content="Send anyway"
                AutomationProperties.Name="Send anyway, the message may contain a secret" />
    </StackPanel>
</UserControl>
