<?xml version="1.0" encoding="utf-8"?>
<!-- Framework-dependent single-file publish (the Desktop runtime 10 is installed on the target). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>bin\publish\</PublishDir>
    <DebugType>none</DebugType>
    <!-- The analyzer would pull the Microsoft.NET.ILLink.Tasks package into restore, so the locked
         restore of a publish would differ from a build's. The app reads no file paths from its own
         assemblies (fixtures are manifest resources). -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
