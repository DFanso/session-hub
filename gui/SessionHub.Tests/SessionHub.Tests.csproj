<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- CA1707: xUnit test names use underscores (Some_behaviour_is_true) by convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SessionHub.Core\SessionHub.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures\*.ndjson" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
